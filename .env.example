# ==============================================================================
# AI-Based Road Damage Detection & Object Recognition System
# Environment Configuration Template
# COPY THIS FILE TO .env AND POPULATE WITH REAL CREDENTIALS (DO NOT COMMIT .env)
# ==============================================================================

# Application & Server Settings
PROJECT_NAME="AI Road Damage & Object Detection System"
APP_ENV=development # Set to "production" in deployed cloud environments
DEBUG=True
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000","https://*.bolt.new","https://*.hf.space","https://*.onrender.com","https://*.railway.app"]

# Cloud Demo Mode
# Set DEMO_MODE=true on cloud hosts (Hugging Face / Render / Railway) where the backend cannot reach private LAN IP.
# Runs full dual-YOLO inference on looped high-definition road damage samples so the public link is always live.
DEMO_MODE=false

# Camera Configuration (CP PLUS CP-E25A)
# IMPORTANT: Never commit actual camera IP, username, or password to version control.
CAMERA_NAME="CP-PLUS-CP-E25A"
CAMERA_IP=192.168.1.100
# CP PLUS Happytimesoft firmware default RTSP port is 5543; Dahua ONVIF standard is 554.
CAMERA_RTSP_PORT=5543
CAMERA_RTSP_PATH=/live/channel1
# For standard Dahua / CP PLUS firmware, use:
# CAMERA_RTSP_PORT=554
# CAMERA_RTSP_PATH=/cam/realmonitor?channel=1&subtype=1
CAMERA_ONVIF_PORT=8000
CAMERA_USERNAME=admin
CAMERA_PASSWORD=your_camera_password_here
CAMERA_STREAM_SUBTYPE=1
# Optional custom RTSP URL override (leaves empty to auto-construct from IP, port, and credentials)
CAMERA_RTSP_OVERRIDE_URL=""
# Reconnection settings
CAMERA_RECONNECT_INTERVAL_SECONDS=5
CAMERA_MAX_RECONNECT_ATTEMPTS=10

# AI Model Inference Settings
DEVICE=cpu # CPU inference for free cloud containers, "cuda" if GPU is available
ROAD_DAMAGE_MODEL_PATH="models/road_damage_best.pt"
GENERAL_OBJECT_MODEL_PATH="models/yolov8n.pt"
ROAD_DAMAGE_CONF_THRESHOLD=0.35
GENERAL_OBJECT_CONF_THRESHOLD=0.45
INFERENCE_IMAGE_SIZE=640
FRAME_SKIP=2 # Process every Nth frame to preserve real-time throughput

# Storage & Database Settings
DATABASE_URL="sqlite+aiosqlite:///storage/road_detection.db"
SNAPSHOT_DIR="storage/snapshots"
SAVE_DETECTION_SNAPSHOTS=True

# Security & Access Control
# Required in production (APP_ENV=production): Must be at least 16 random characters.
API_SECRET_KEY="generate_a_secure_random_key_for_production_use"
